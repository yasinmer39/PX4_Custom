    <link name="payload_mass">
      <self_collide>false</self_collide>
      <pose relative_to="base_ref">0 0.16 0.20 0 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.0146</ixx><iyy>0.0146</iyy><izz>0.0146</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <velocity_decay>
        <linear>0.002</linear>
        <angular>0.002</angular>
