    <!-- === GERÇEKÇİ YÜK KAYMASI === -->
    <link name="payload_carriage">
      <self_collide>false</self_collide>
      <pose relative_to="base_ref">0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <velocity_decay>
        <linear>0.005</linear>
        <angular>0.005</angular>
      </velocity_decay>
      <enable_wind>true</enable_wind>
      <visual name="carriage_vis">
        <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 0.7 0 1</diffuse></material>
      </visual>
      <collision name="carriage_col">
        <geometry><box><size>0.018 0.018 0.018</size></box></geometry>
        <max_contacts>0</max_contacts>
        <surface><contact><collide_bitmask>0x0000</collide_bitmask></contact></surface>
      </collision>
    </link>

    <link name="payload_y">
      <self_collide>false</self_collide>
      <pose relative_to="base_ref">0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
