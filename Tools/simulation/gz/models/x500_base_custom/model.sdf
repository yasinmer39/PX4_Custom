<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <model name="x500_base_custom">
    <pose>0 0 15.33 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- === MASTER REFERENCE FRAME === -->
    <frame name="base_ref" attached_to="base_link">
      <pose>0.01 0.016 0 0 0 0</pose>
    </frame>

    <!-- === BASE LINK === -->
    <link name="base_link">
      <inertial>
        <mass>25.000</mass>
        <inertia>
          <ixx>0.02166666666666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02166666666666667</iyy>
          <iyz>0</iyz>
          <izz>0.04000000000000001</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay>
        <linear>0.01</linear>
        <angular>0.01</angular>
      </velocity_decay>
      <enable_wind>true</enable_wind>

      <!-- Görsel artık base_ref'e göre ve pose=0 -->
      <visual name="base_link_visual">
        <pose relative_to="base_ref">0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.009 0.013 0.01</scale>
            <uri>model://x500_base_custom/meshes/last.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Motor taban görselleri -->
      <visual name="5010_motor_base_0">
        <pose relative_to="base_ref">0.689 0.7535 0.55 0 0 -0.90</pose>
        <geometry>
          <mesh>
            <scale>0.1 0.1 0.1</scale>
            <uri>model://x500_base_custom/meshes/motorbase.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="5010_motor_base_1">
        <pose relative_to="base_ref">-0.689 0.7535 0.55 0 0 0.90</pose>
        <geometry>
          <mesh>
            <scale>0.1 0.1 0.1</scale>
            <uri>model://x500_base_custom/meshes/motorbase.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="5010_motor_base_2">
        <pose relative_to="base_ref">0.689 -0.7535 0.55 0 0 -2.10</pose>
        <geometry>
          <mesh>
            <scale>0.1 0.1 0.1</scale>
            <uri>model://x500_base_custom/meshes/motorbase.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="5010_motor_base_3">
        <pose relative_to="base_ref">-0.689 -0.7535 0.55 0 0 -4.2</pose>
        <geometry>
          <mesh>
            <scale>0.1 0.1 0.1</scale>
            <uri>model://x500_base_custom/meshes/motorbase.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <!-- Üstteki yazılar -->
      <visual name="NXP_FMUK66_FRONT">
        <pose relative_to="base_ref">0.047 .001 .043 1 0 1.57</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>.013 .007</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>model://x500_base_custom/materials/textures/nxp.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="NXP_FMUK66_TOP">
        <pose relative_to="base_ref">-0.023 0 .0515 0 0 -1.57</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>.013 .007</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
