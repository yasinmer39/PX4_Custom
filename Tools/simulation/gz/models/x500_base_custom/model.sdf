      <visual name="RDDRONE_FMUK66_TOP">
        <pose relative_to="base_ref">-.03 0 .0515 0 0 -1.57</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
