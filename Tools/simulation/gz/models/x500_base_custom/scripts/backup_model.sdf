<!-- === GERÇEKÇİ YÜK KAYMASI: GÖRSEL KUTULAR + X–Y–Z PRİZMATİK ZİNCİRİ (COLLISION FIX) === -->

<!-- X ekseni için ilk taşıyıcı (yeşil) -->
<link name="payload_carriage">
  <self_collide>false</self_collide>
  <pose>0 0 0.20 0 0 0</pose>
  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
      <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
    </inertia>
  </inertial>
  <visual name="carriage_vis">
    <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
    <material><ambient>0 1 0 1</ambient><diffuse>0 0.7 0 1</diffuse></material>
  </visual>
  <!-- Küçük ve çarpışması kapalı kutu -->
  <collision name="carriage_col">
    <geometry><box><size>0.018 0.018 0.018</size></box></geometry>
    <max_contacts>0</max_contacts>
    <surface>
      <contact>
        <collide_bitmask>0x0000</collide_bitmask>
      </contact>
    </surface>
  </collision>
</link>

<!-- Y ekseni için ara taşıyıcı (mavi) -->
<link name="payload_y">
  <self_collide>false</self_collide>
  <pose>0 0 0.20 0 0 0</pose>
  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
      <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
    </inertia>
  </inertial>
  <visual name="y_vis">
    <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
    <material><ambient>0 0 1 1</ambient><diffuse>0 0 0.8 1</diffuse></material>
  </visual>
  <!-- Küçük ve çarpışması kapalı kutu -->
  <collision name="y_col">
    <geometry><box><size>0.018 0.018 0.018</size></box></geometry>
    <max_contacts>0</max_contacts>
    <surface>
      <contact>
        <collide_bitmask>0x0000</collide_bitmask>
      </contact>
    </surface>
  </collision>
</link>

<!-- Asıl yük (kırmızı) -->
<link name="payload_mass">
  <self_collide>false</self_collide>
  <pose>0 0.16 0.20 0 0 0</pose>
  <inertial>
    <mass>35</mass>
    <!-- 5 cm küp varsayımıyla daha gerçekçi atalet -->
    <inertia>
      <ixx>0.0146</ixx><iyy>0.0146</iyy><izz>0.0146</izz>
      <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
    </inertia>
  </inertial>
  <visual name="mass_vis">
    <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
    <material><ambient>1 0 0 1</ambient><diffuse>0.8 0 0 1</diffuse></material>
  </visual>
  <!-- Küçük ve çarpışması kapalı kutu -->
  <collision name="mass_col">
    <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
    <max_contacts>0</max_contacts>
    <surface>
      <contact>
        <collide_bitmask>0x0000</collide_bitmask>
      </contact>
    </surface>
  </collision>
</link>

<!-- X: base_link -> payload_carriage -->
<joint name="payload_slide_x" type="prismatic">
  <parent>base_link</parent>
  <child>payload_carriage</child>
  <pose>0 0 0 0 0 0</pose>
  <axis>
    <xyz>1 0 0</xyz>
    <use_parent_model_frame>true</use_parent_model_frame>
    <limit>
      <lower>-0.1</lower><upper>0.1</upper>
      <effort>200</effort><velocity>1.0</velocity>
    </limit>
    <dynamics><damping>0.1</damping><friction>0.0</friction></dynamics>
  </axis>
</joint>

<!-- Y: payload_carriage -> payload_y -->
<joint name="payload_slide_y" type="prismatic">
  <parent>payload_carriage</parent>
  <child>payload_y</child>
  <pose>0 0 0 0 0 0</pose>
  <axis>
    <xyz>0 1 0</xyz>
    <use_parent_model_frame>true</use_parent_model_frame>
    <limit>
      <lower>-0.1</lower><upper>0.1</upper>
      <effort>200</effort><velocity>1.0</velocity>
    </limit>
    <dynamics><damping>0.1</damping><friction>0.0</friction></dynamics>
  </axis>
</joint>

<!-- Z: payload_y -> payload_mass -->
<joint name="payload_slide_z" type="prismatic">
  <parent>payload_y</parent>
  <child>payload_mass</child>
  <pose>0 0 0 0 0 0</pose>
  <axis>
    <xyz>0 0 1</xyz>
    <use_parent_model_frame>true</use_parent_model_frame>
    <limit>
      <lower>-0.1</lower><upper>0.1</upper>
      <effort>1000</effort><velocity>2.0</velocity>
    </limit>
    <dynamics><damping>0.1</damping><friction>0.0</friction></dynamics>
  </axis>
</joint>

<!-- === PID Kontrol Pluginleri === -->
<plugin name="gz::sim::systems::JointPositionController"
        filename="libgz-sim-joint-position-controller-system.so">
  <joint_name>payload_slide_x</joint_name>
  <topic>/x500/payload/slide_x/cmd</topic>
  <p_gain>100</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
</plugin>

<plugin name="gz::sim::systems::JointPositionController"
        filename="libgz-sim-joint-position-controller-system.so">
  <joint_name>payload_slide_y</joint_name>
  <topic>/x500/payload/slide_y/cmd</topic>
  <p_gain>100</p_gain><i_gain>0</i_gain><d_gain>1</d_gain>
</plugin>

<plugin name="gz::sim::systems::JointPositionController"
        filename="libgz-sim-joint-position-controller-system.so">
  <joint_name>payload_slide_z</joint_name>
  <topic>/x500/payload/slide_z/cmd</topic>
  <p_gain>120</p_gain><i_gain>5</i_gain><d_gain>1</d_gain>
</plugin>


  </model>
</sdf>
